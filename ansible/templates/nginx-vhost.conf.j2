# Managed by Ansible. Mirrors terraform/deploy/nginx-bootstrap.sh: routes live in
# /etc/nginx/rp-app-locations.inc (SPAs + per-box backends), written by the bootstrap.
server {
    listen 80 default_server;
    server_name _;

    location = /health {
        add_header Content-Type text/plain;
        return 200 'ok';
    }
    # Let's Encrypt HTTP-01 challenges (terraform/deploy/enable-letsencrypt.sh); keep plain HTTP
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name _;

{% if ssl_domain %}
    ssl_certificate     {{ ssl_cert_dir }}/{{ ssl_domain }}.crt;
    ssl_certificate_key {{ ssl_cert_dir }}/{{ ssl_domain }}.key;
{% else %}
    ssl_certificate     {{ ssl_cert_dir }}/selfsigned.crt;
    ssl_certificate_key {{ ssl_cert_dir }}/selfsigned.key;
{% endif %}
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Optional route files (glob = no error if absent): jira/todo from bootstrap, kids/solar from revakunj
    include /etc/nginx/rp-app-locations*.inc;
    include /etc/nginx/rp-revakunj-locations*.inc;

}
