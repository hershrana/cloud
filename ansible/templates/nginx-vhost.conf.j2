# Managed by Ansible. Mirrors terraform/deploy/nginx-bootstrap.sh: routes live in
# /etc/nginx/rp-app-locations.inc (SPAs + per-box backends), written by the bootstrap.
server {
    listen 80 default_server;
    server_name _;

    location = /health {
        add_header Content-Type text/plain;
        return 200 'ok';
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name _;

    ssl_certificate     {{ ssl_cert_dir }}/selfsigned.crt;
    ssl_certificate_key {{ ssl_cert_dir }}/selfsigned.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    include /etc/nginx/rp-app-locations.inc;
}
